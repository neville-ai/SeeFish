# Salin file ini menjadi .env untuk pengembangan lokal.
# Jangan commit file .env atau nilai kredensial sebenarnya.

APP_NAME=SeeFish
APP_ENV=local
APP_TIMEZONE=Asia/Makassar

# Session
SESSION_NAME=SEEFISH_SESSID
# Gunakan true pada produksi HTTPS. Nilai auto mendeteksi HTTPS.
SESSION_SECURE=auto
SESSION_TIMEOUT=1800

# Kebijakan password
PASSWORD_MIN_LENGTH=12

# Batas baris ekspor CSV laporan operasional (default 10000)
CSV_EXPORT_MAX_ROWS=10000

# Database lokal
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=seefish_db
DB_USER=seefish_app
DB_PASS=seefishdevops
